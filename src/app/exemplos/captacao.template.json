{
  "version": "v1",
  "unit": "mm",
  "page": {
    "widthMm": 210,
    "heightMm": 297,
    "margin": {
      "topMm": 8,
      "rightMm": 10,
      "bottomMm": 10,
      "leftMm": 10
    }
  },
  "styles": {
    "meta": {
      "fontSizePt": 7,
      "color": "#333333",
      "align": "right"
    },
    "municipio": {
      "fontSizePt": 17,
      "fontWeight": "bold",
      "padding": {
        "leftMm": 16
      },
      "margin": {
        "topMm": 3
      }
    },
    "quadrimestre": {
      "fontSizePt": 10,
      "padding": {
        "leftMm": 16
      },
      "margin": {
        "bottomMm": 5
      }
    },
    "titulo": {
      "fontSizePt": 16,
      "fontWeight": "bold",
      "border": {
        "widthMm": 0.3,
        "color": "#999999",
        "sides": "t"
      },
      "padding": {
        "topMm": 1.5,
        "bottomMm": 1
      }
    },
    "rotulo": {
      "fontSizePt": 7.5,
      "fontWeight": "bold"
    },
    "th": {
      "fontSizePt": 7.5,
      "fontWeight": "bold",
      "padding": {
        "topMm": 1.5,
        "rightMm": 1,
        "bottomMm": 1.5,
        "leftMm": 1
      },
      "border": {
        "widthMm": 0.3,
        "color": "#999999",
        "sides": "b"
      },
      "margin": {
        "topMm": 1
      }
    },
    "td": {
      "fontSizePt": 7.5,
      "verticalAlign": "middle",
      "minHeightMm": 7,
      "padding": {
        "topMm": 1,
        "rightMm": 1,
        "bottomMm": 1,
        "leftMm": 1
      },
      "border": {
        "widthMm": 0.2,
        "color": "#999999",
        "sides": "b"
      }
    },
    "direita": {
      "align": "right"
    },
    "obs": {
      "fontSizePt": 7.5,
      "padding": {
        "topMm": 1,
        "rightMm": 1,
        "bottomMm": 1,
        "leftMm": 1
      },
      "border": {
        "widthMm": 0.2,
        "color": "#999999",
        "sides": "b"
      }
    },
    "resumo": {
      "fontSizePt": 7.5,
      "padding": {
        "topMm": 0.5,
        "bottomMm": 0.5
      }
    },
    "rodape": {
      "fontSizePt": 6.5,
      "color": "#333333"
    }
  },
  "sections": {
    "pageHeader": {
      "components": [
        {
          "type": "text",
          "styleRef": "meta",
          "bind": "@report.generatedAt",
          "format": {
            "type": "datetime",
            "pattern": "EEEE, dd 'de' MMMM 'de' yyyy HH:mm"
          },
          "text": {}
        }
      ]
    },
    "reportHeader": {
      "components": [
        {
          "type": "text",
          "styleRef": "municipio",
          "bind": "header.cliente_nome",
          "text": {}
        },
        {
          "type": "text",
          "styleRef": "quadrimestre",
          "bind": "header.quadrimestre_nome",
          "text": {}
        },
        {
          "type": "text",
          "styleRef": "titulo",
          "text": {
            "parts": [
              {
                "bind": "header.indicador_codigo"
              },
              {
                "value": " - "
              },
              {
                "bind": "header.indicador_nome"
              }
            ]
          }
        },
        {
          "type": "text",
          "styleRef": "rotulo",
          "text": {
            "parts": [
              {
                "value": "Equipe: "
              },
              {
                "bind": "data[0].equipe_nome"
              }
            ]
          }
        },
        {
          "type": "text",
          "styleRef": "rotulo",
          "text": {
            "parts": [
              {
                "value": "INE: "
              },
              {
                "bind": "data[0].equipe_ine"
              }
            ]
          }
        }
      ]
    },
    "content": {
      "components": [
        {
          "type": "table",
          "id": "cidadaos",
          "table": {
            "dataPath": "data",
            "header": {
              "styleRef": "th"
            },
            "columns": [
              {
                "key": "cidadao_prontuario",
                "title": "Matrícula",
                "widthMm": 24,
                "styleRef": "td"
              },
              {
                "key": "cidadao_nome",
                "title": "Cidadão",
                "weight": 1,
                "styleRef": "td"
              },
              {
                "key": "cidadao_cns",
                "title": "CNS",
                "widthMm": 40,
                "styleRef": "td",
                "format": {
                  "nullText": ""
                }
              },
              {
                "key": "consultas",
                "title": "1ª Consultas",
                "widthMm": 26,
                "styleRef": "td direita"
              },
              {
                "key": "status_nome",
                "title": "Status",
                "widthMm": 26,
                "styleRef": "td direita",
                "format": {
                  "transform": "upper"
                }
              }
            ],
            "detail": {
              "when": {
                "path": "observacoes",
                "op": "notEmpty"
              },
              "components": [
                {
                  "type": "text",
                  "styleRef": "obs",
                  "bind": "observacoes[0]",
                  "text": {}
                }
              ]
            },
            "emptyMessage": "Nenhum cidadão nesta captação."
          }
        }
      ]
    },
    "summary": {
      "components": [
        {
          "type": "spacer",
          "spacer": {
            "heightMm": 6
          }
        },
        {
          "type": "row",
          "row": {
            "columns": [
              {
                "widthMm": 28,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "text": {
                      "value": "Atingíveis:"
                    }
                  }
                ]
              },
              {
                "weight": 1,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "bind": "sumario.atingiveis",
                    "format": {
                      "type": "number",
                      "decimals": 0
                    },
                    "text": {}
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "row",
          "row": {
            "columns": [
              {
                "widthMm": 28,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "text": {
                      "value": "Considerados:"
                    }
                  }
                ]
              },
              {
                "weight": 1,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "bind": "sumario.considerados",
                    "format": {
                      "type": "number",
                      "decimals": 0
                    },
                    "text": {}
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "row",
          "row": {
            "columns": [
              {
                "widthMm": 28,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "text": {
                      "value": "Desconsiderados:"
                    }
                  }
                ]
              },
              {
                "weight": 1,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "bind": "sumario.desconsiderados",
                    "format": {
                      "type": "number",
                      "decimals": 0
                    },
                    "text": {}
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "row",
          "row": {
            "columns": [
              {
                "widthMm": 28,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "text": {
                      "value": "Total:"
                    }
                  }
                ]
              },
              {
                "weight": 1,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "resumo",
                    "bind": "sumario.total",
                    "format": {
                      "type": "number",
                      "decimals": 0
                    },
                    "text": {}
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "pageFooter": {
      "components": [
        {
          "type": "row",
          "row": {
            "columns": [
              {
                "weight": 1,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "rodape",
                    "text": {
                      "parts": [
                        {
                          "value": "Impresso por: "
                        },
                        {
                          "bind": "metadados.usuario"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "weight": 1,
                "components": [
                  {
                    "type": "text",
                    "styleRef": "rodape direita",
                    "text": {
                      "parts": [
                        {
                          "value": "Página "
                        },
                        {
                          "bind": "@page.number"
                        },
                        {
                          "value": " de "
                        },
                        {
                          "bind": "@page.total"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}